<style>
.footer {
  background: #0A2C0C; 
  color: #e5efe8;
  padding: 80px 40px;
  font-family: sans-serif;
}


.container {
  max-width: 1200px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 60px;
}


.col h4 {
  margin-bottom: 20px;
  font-size: 16px;
  letter-spacing: 1px;
}


.col a {
  display: block;
  margin-bottom: 10px;
  color: #e5efe8;
  text-decoration: none;
  font-size: 14px;
  opacity: 0.9;
  transition: 0.2s;
}

.col a:hover {
  opacity: 1;
  text-decoration: underline;
}


.col p {
  font-size: 14px;
  margin-bottom: 10px;
  opacity: 0.9;
}



@media (max-width: 500px) {
  .container {
    grid-template-columns: 1fr;
  }
}
</style>