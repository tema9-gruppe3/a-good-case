---
const { title, text, image, alt, reverse = false } = Astro.props;
---

<section class={reverse ? "card reverse" : "card"}>
  <div class="card-image">
    <img src={image} alt={alt} />
  </div>

  <div class="card-text">
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
</section>

<style>
  .card {
    display: flex;
    gap: 2rem;
    background: #FBFBF7;
    padding: 1.5rem;
    margin-bottom: 1rem;
    align-items: center;
  }

  .reverse {
    flex-direction: row-reverse;
     background: #ffffff;
  }

  .card-image img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    display: block;
  }

  .card-text {
    flex: 1;
  }

  .card-text h3 {
    margin-bottom: 0.75rem;
    font-size: 1.8rem;
  }

  .card-text p {
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .card,
    .reverse {
      flex-direction: column;
      align-items: flex-start;
    }

    .card-image img {
      width: 100%;
      height: auto;
    }
  }
</style>