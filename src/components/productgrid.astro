---
//@ts-nocheck
import Pcard from "./Pcard.astro"
---

<section class="products">

  <div class="grid">
    <Pcard />
   
  </div>

  <a href="#" class="see-all">Se alle</a>

<style>
.products {
  padding: 0rem 2rem 4rem 2rem;
  text-align: center;

      font-family: sans-serif;
     
}





.grid a {
  text-decoration: none;
  color: #000;
}
.card {
  text-align: center;
  text-decoration: none;
}

.image-wrapper {
  border-radius: 12px;
  padding: 2rem;
  margin-bottom: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-wrapper img {
  height: 160px;
  object-fit: contain;
}

.brand {
  font-size: 0.8rem;
  text-transform: uppercase; 
  letter-spacing: 1px;
  font-weight: 200;
  color: gray;
}

h3 {
  font-size: 1rem;
  margin: 0.5rem 0;
  font-weight: 550;
  text-transform: uppercase; 
  color: black;
  text-decoration: none;
}

.price {
  font-size: 0.9rem;
  margin-bottom: 1rem;
    font-weight: 200;
}

button {
  border: 1px solid #2e3d2f;
  background: transparent;
  padding: 0.5rem 1.5rem;
  border-radius: 999px;
  cursor: pointer;
}

button:hover {
  background: #2e3d2f;
  color: white;
}

</style>