---
//@ts-nocheck
const endpoint = "https://pcuccheoqxtgipxffkca.supabase.co/rest/v1/beer?select=*";
const options={
  headers: {
    apikey: "sb_publishable_Mrlx3PF_AAOoGsqYkZUdAg_MuIytlea",
  }
}
const data = await fetch(endpoint, options).then(res => res.json());

const {products} = Astro.props;

---

<section class="products">
  <h2>NYHEDER</h2>

  <div class="grid">
    {data.map((p) => (
      <a href={`details/${p.id}`}>
      <div class="card">
        <div class="image-wrapper" style={`background:${p.bg}`}>
          <img src={p.image} alt={p.productname} />
        </div>

        <p class="brand">{p.brand}</p>
        <h3>{p.productname}</h3>
        <p class="price">{p.price} DKK</p>
        <button>Læg i kurv</button>
        </div>
        </a>
    ))}
  </div>

  <a href="#" class="see-all">Se alle</a>
</section>

<style>
.products {
  padding: 4rem 2rem;
  text-align: center;
  background: #FBFBF7;
      font-family: sans-serif;
}

h2 {
  letter-spacing: 4px;
  font-weight: 400;
  margin-bottom: 3rem;

}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.card {
  text-align: center;
}

.image-wrapper {
  border-radius: 12px;
  padding: 2rem;
  margin-bottom: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-wrapper img {
  height: 160px;
  object-fit: contain;
}

.brand {
  font-size: 0.8rem;
  text-transform: uppercase; 
  letter-spacing: 1px;
  font-weight: 200;
  color: gray;
}

h3 {
  font-size: 1rem;
  margin: 0.5rem 0;
  font-weight: 550;
  text-transform: uppercase; 
}

.price {
  font-size: 0.9rem;
  margin-bottom: 1rem;
    font-weight: 200;
}

button {
  border: 1px solid #2e3d2f;
  background: transparent;
  padding: 0.5rem 1.5rem;
  border-radius: 999px;
  cursor: pointer;
}

button:hover {
  background: #2e3d2f;
  color: white;
}

.see-all {
  display: inline-block;
  margin-top: 2rem;
  font-size: 0.9rem;
  text-decoration: underline;
  color: black;
}
</style>