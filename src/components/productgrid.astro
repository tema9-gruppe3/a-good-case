---
//@ts-nocheck
const endpoint = "https://pcuccheoqxtgipxffkca.supabase.co/rest/v1/beer?select=*";
const options={
  headers: {
    apikey: "sb_publishable_Mrlx3PF_AAOoGsqYkZUdAg_MuIytlea",
  }
}
const products = await fetch(endpoint, options).then(res => res.json());



---

<section class="products">
  <h2>NYHEDER</h2>

  <div class="grid">
    {products.map((p) => (
      <div class="card">
        <div class="image-wrapper" style={`background:${p.bg}`}>
          <img src={p.image} alt={p.title} />
        </div>

        <p class="brand">{p.brand}</p>
        <h3>{p.title}</h3>
        <p class="price">{p.price}</p>

        <button>Læg i kurv</button>
      </div>
    ))}
  </div>

  <a href="#" class="see-all">Se alle</a>
</section>

<style>
.products {
  padding: 4rem 2rem;
  text-align: center;
  background: #f5f5f3;
      font-family: sans-serif;
}

h2 {
  letter-spacing: 4px;
  font-weight: 400;
  margin-bottom: 3rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.card {
  text-align: center;
}

.image-wrapper {
  border-radius: 12px;
  padding: 2rem;
  margin-bottom: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-wrapper img {
  height: 160px;
  object-fit: contain;
}

.brand {
  font-size: 0.8rem;

  letter-spacing: 1px;
}

h3 {
  font-size: 1rem;
  margin: 0.5rem 0;
}

.price {
  font-size: 0.9rem;
  margin-bottom: 1rem;
}

button {
  border: 1px solid #2e3d2f;
  background: transparent;
  padding: 0.5rem 1.5rem;
  border-radius: 999px;
  cursor: pointer;
}

button:hover {
  background: #2e3d2f;
  color: white;
}

.see-all {
  display: inline-block;
  margin-top: 2rem;
  font-size: 0.9rem;
  text-decoration: underline;
}
</style>