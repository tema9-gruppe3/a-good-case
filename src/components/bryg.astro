<style>
.logos {
  padding: 300px 0 60px 0;

  text-align: center;
  font-family: sans-serif;
}

.logos h2 {
  letter-spacing: 4px;
  margin-bottom: 40px;
  font-weight: 400;
}


.slider {
  overflow: hidden;
  width: 100%;
}


.track {
  display: flex;
  gap: 80px;
  width: max-content;

  animation: scroll 35s linear infinite;
}


.track img {
  height: 120px;
  width: auto;
  object-fit: contain;

}


@keyframes scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
</style>