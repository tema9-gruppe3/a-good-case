<style>
.logos {
  padding: 300px 0 60px 0;
  background: #f5f5f5;
  text-align: center;
  font-family: sans-serif;
}

.logos h2 {
  letter-spacing: 4px;
  margin-bottom: 40px;
}


.slider {
  overflow: hidden;
  width: 100%;
}


.track {
  display: flex;
  gap: 80px;
  width: max-content;

  animation: scroll 25s linear infinite;
}


.track img {
  height: 80px;
  width: auto;
  object-fit: contain;
  opacity: 0.8;
}


@keyframes scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
</style>