---
//@ts-nocheck
import Layout from '../layouts/Layout.astro';
import Pcard from '../components/Pcard.astro';

const endpoint = "https://pcuccheoqxtgipxffkca.supabase.co/rest/v1/beer?select=*";

const options = {
  headers: {
    apikey: "sb_publishable_Mrlx3PF_AAOoGsqYkZUdAg_MuIytlea",
  }
};

const data = await fetch(endpoint, options).then(res => res.json());
---

<Layout>

  <section class="products">
    <h2>ALLE ØL</h2>
  </section>

  <section id="buttons">
    <button data-type="alle">ALLE</button>
    <button data-type="ipa">IPA</button>
    <button data-type="ale">ALE</button>
    <button data-type="wild">WILD ALE</button>
  </section>


  <section id="Plist" class="grid">
    {data.map((product) => (
      <Pcard product={product} />
    ))}
  </section>

</Layout>

<style>


#buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 2rem;

}
#buttons button {
  padding: 0.5rem 1rem;
  border: none;
  background: #214e14;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 500;
  color: #ffffff;
} 

#buttons button:hover {
  background: #4d8d4a;
  color: black;
}


.price {
  font-size: 0.9rem;
  margin-bottom: 1rem;
    font-weight: 200;
}
.products {
  padding: 4rem 2rem 0rem 2rem;
  text-align: center;
  font-family: sans-serif;
}

h2 {
  letter-spacing: 4px;
  font-weight: 400;
  margin-bottom: 3rem;
}

.hide {
  display: none;
}


.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  padding: 2rem;
}


#Plist a {
  text-decoration: none;
  color: #000;
}
</style>

<script>
document
  .querySelectorAll("#buttons button")
  .forEach((button) =>
    button.addEventListener("click", filtrer)
  );

function filtrer(e: any) {
  const cards = document.querySelectorAll(".Pcard");
  const valgtType = e.target.dataset.type.toLowerCase();

  cards.forEach((card) => {
    const type = card.getAttribute("data-type")?.toLowerCase() || "";

    if (type.includes(valgtType) || valgtType === "alle") {
      card.classList.remove("hide");
    } else {
      card.classList.add("hide");
    }
  });
}
</script>