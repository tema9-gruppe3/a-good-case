---
//@ts-nocheck
import Layout from '../layouts/Layout.astro';
import Pcard from '../components/Pcard.astro';
import Productgrid2 from '../components/productgrid2.astro';

const endpoint = "https://pcuccheoqxtgipxffkca.supabase.co/rest/v1/beer?select=*";

const options = {
  headers: {
    apikey: "sb_publishable_Mrlx3PF_AAOoGsqYkZUdAg_MuIytlea",
  }
};

const data = await fetch(endpoint, options).then(res => res.json());
---

<Layout>

  <section class="products">
    <h2>ALLE ØL</h2>
  </section>

  <section id="buttons">
    <button data-type="Ale">Alle</button>
    <button data-type="IPA">IPA</button>
    <button data-type="ALE">ALE</button>
    <button data-type="WILD">WILD ALE</button>
  
  </section>

  <section id="Plist">
    {data.map((product) => (
      <Pcard product={product} />
    ))}
  </section>

  <Productgrid2 />

</Layout>
<style>.products {
  padding: 4rem 2rem 0rem 2rem;
  text-align: center;

      font-family: sans-serif;
}

h2 {
  letter-spacing: 4px;
  font-weight: 400;
  margin-bottom: 3rem;

}
.hide {
  display: none;
}
</style>

<script>
  document
    .querySelectorAll("button")
    .forEach((button) =>
      button.addEventListener("click", filtrer)
    );

  function filtrer(e: any) {
    const cards = document.querySelectorAll(".Pcard");
    const valgtType = e.target.dataset.type;

    cards.forEach((card) => {
      const type = card.getAttribute("data-type");

      if (type === valgtType || valgtType === "Alle") {
        card.classList.remove("hide");
      } else {
        card.classList.add("hide");
      }
    });
  }
</script>