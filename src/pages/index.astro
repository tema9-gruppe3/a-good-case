---

import Layout from '../layouts/Layout.astro';

import Hero from "../components/hero.astro";
import ProductGrid from "../components/productgrid.astro";
import Categories from "../components/categories.astro";
import AboutFrontPage from "../components/AboutFrontPage.astro";
import Social from "../components/social.astro";
import ProductGrid2 from "../components/productgrid2.astro";
import OpeningHour from "../components/openinghour.astro";
import Slider from "../components/bryg.astro";
import Footer from "../components/footer.astro";
---

<Layout>

<main>
  <Hero />
  <section class="products">
    <h2>NYHEDER</h2>
    </section>
  <ProductGrid />
  <Categories />
  <AboutFrontPage />
  <Social />
  <ProductGrid2 />
  <OpeningHour />
  <Slider />
  <Footer />

</main>
</Layout>

<style>
.products {
  padding: 4rem 2rem 0rem 2rem;
  text-align: center;
  background: #FBFBF7;
      font-family: sans-serif;
}

h2 {
  letter-spacing: 4px;
  font-weight: 400;
  margin-bottom: 3rem;

}
</style>
