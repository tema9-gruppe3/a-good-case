---
import Layout from "../layouts/Layout.astro";
import AboutHero from "../components/AboutHero.astro";
import AboutReasonCard from "../components/AboutReasonCard.astro";
import AboutS from "../components/AboutS.astro";
import AboutPeople from "../components/AboutPeople.astro";
---

<Layout title="About">
  <main class="about-page">
    <AboutHero
      title="A Good Case"
      text1="Hos A Good Case arbejder vi for at reducere spild ved at give gode produkter en ny chance. Alt for mange varer bliver kasseret på grund af små fejl, overproduktion eller timing – selvom kvaliteten stadig er i top."
      text2="Vi opkøber disse partier fra producenter og leverandører og sælger dem videre til en bedre pris. Det betyder, at du som kunde får adgang til kvalitetsprodukter, samtidig med at vi sammen mindsker unødvendigt spild."
      text3="For os handler det om at tænke anderledes og skabe værdi – for både producenter, forbrugere og miljøet."
      image="/images/about-1.png"
      alt="Medarbejdere fra A Good Case"
    />

    <section class="reasons">
      <h2>Hvad er årsagerne til at vi giver øl nyt liv?</h2>

      <AboutReasonCard
        title="Emballagefejl"
        text={`Ikke alle produkter forlader produktionen i perfekt indpakning – men det betyder ikke, at der er noget galt med indholdet. Emballagefejl can være alt fra skæve etiketter og trykfejl til mindre visuelle afvigelser, som gør, at produkterne ikke lever op til producentens standarder for detailhandel. Hos os ser vi værdien i det, der ellers bliver fravalgt. Vi opkøber partier med kosmetiske fejl og giver dem en ny chance. Det betyder, at du som kunde får adgang til kvalitetsprodukter til en lavere pris – uden at gå på kompromis med smag eller oplevelse. Samtidig er du med til at reducere unødvendigt spild, fordi produkter, der ellers kunne være blevet kasseret, i stedet bliver brugt.`}
        image="/images/about-2.png"
        alt="Øl med emballagefejl"
      />

      <AboutReasonCard
        title="Overproduktion"
        text={`Overproduktion er en naturlig del af mange industrier. Efterspørgslen kan være svær at forudsige, og det resulterer ofte i overskudslagre, som ikke når at blive solgt gennem de traditionelle kanaler. I stedet for at lade disse varer gå til spilde, opkøber vi overskudspartier direkte fra producenter og distributører. Det giver os mulighed for at tilbyde produkter af høj kvalitet til markant lavere priser. For dig betyder det gode deals – og for producenterne betyder det mindre spild og bedre ressourceudnyttelse. Det er en løsning, hvor alle vinder: producenter, forbrugere og miljøet.`}
        image="/images/about-3.png"
        alt="Ølproduktion"
        reverse={true}
      />

      <AboutReasonCard
        title="Bedst før dato"
        text={`Mange produkter bliver kasseret alene på grund af en dato på emballagen – men “bedst før” er ikke det samme som “dårlig efter”. Det er en vejledende dato, der angiver, hvornår produktet er på sit absolut bedste i forhold til smag og kvalitet. Vi opkøber varer, der nærmer sig denne dato, og sikrer, at de stadig lever op til en god oplevelse. På den måde kan du købe kvalitetsprodukter til en reduceret pris, samtidig med at vi sammen bekæmper mad- og ressourcespild. Det handler om at udfordre vanetænkning og skabe en mere ansvarlig måde at forbruge på – uden at gå på kompromis med kvalitet.`}
        image="/images/about-4.png"
        alt="Kalender"
      />

      <AboutReasonCard
        title="Forkert sæson"
        text={`Markedet er i høj grad styret af sæsoner. Nogle produkter er designet til bestemte tidspunkter på året, og når de ikke bliver solgt i rette tid, risikerer de at blive kasseret – selvom kvaliteten stadig er den samme. Vi opkøber disse varer og giver dem nyt liv uden for deres “planlagte” sæson. For hvorfor skulle en god oplevelse være begrænset af kalenderen? Hos os handler det om at tænke anderledes og se muligheder, hvor andre ser begrænsninger. Resultatet er gode produkter til gode priser – året rundt.`}
        image="/images/about-5.png"
        alt="Skov"
        reverse={true}
      />

      <AboutReasonCard
        title="Uventede smagsvarianter"
        text={`I produktion kan der opstå variationer, som gør, at et parti ikke matcher den præcise smagsprofil, producenten havde planlagt. Det kan være små nuancer i smag, aroma eller udtryk – men stadig produkter, der er fuldt ud sikre og nydelige. Vi ser ikke disse variationer som fejl, men som en mulighed. Ved at opkøbe disse partier sikrer vi, at gode produkter ikke går til spilde, samtidig med at vi tilbyder noget unikt til vores kunder. Det giver dig chancen for at opleve produkter med karakter – til en pris, der også giver mening.`}
        image="/images/about-6.png"
        alt="Ølflaske"
      />
    </section>

    <AboutS />
    <AboutPeople />
  </main>
</Layout>

<style>
  .about-page {
    width: 100%;
  }

  .reasons {
    width: 100%;
    margin-top: 2rem;
    padding: 0;
  }

  .reasons h2 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2.2rem;
  }
